<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_on_color"
    tools:context=".HomePage">

    <LinearLayout
        android:id="@+id/header_view_homePage"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_text_homePage"
            android:textSize="14sp"
            android:textColor="@color/secondary_on_color"
            android:fontFamily="@font/poppins"
            android:layout_weight="0.5"/>

        <TextView
            android:id="@+id/username_label_homePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username_text_homePage"
            android:textSize="18sp"
            android:textColor="@color/secondary_on_color"
            android:fontFamily="@font/poppins_extrabold"
            android:layout_weight="0.5"/>
    </LinearLayout>

    <TextView
        android:id="@+id/title_homePage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/poppins_black_italic"
        android:text="@string/favorites_header_text_homePage"
        android:textSize="30sp"
        android:textColor="@color/secondary_on_color"
        app:layout_constraintTop_toBottomOf="@id/header_view_homePage"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/query_view_homePage"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/title_homePage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_homePage"
            android:hint="@string/search_hint_text_homePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:startIconDrawable="@drawable/search_24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="44dp"
                android:paddingEnd="0dp"
                android:inputType="textFilter" />

        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favorites_recycler_homePage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="-40dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/query_view_homePage"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_homePage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/empty_message_homePage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_message_text_homePage"
        android:textColor="@color/secondary_on_color"
        android:fontFamily="@font/poppins"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/favorites_recycler_homePage"
        app:layout_constraintBottom_toBottomOf="@id/favorites_recycler_homePage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_homePage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:itemIconTint="@drawable/item_selector"
        app:itemRippleColor="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bottom_background"
        app:layout_constraintTop_toTopOf="@id/bottom_nav_homePage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>