<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_on_color"
    tools:context=".Randomizer">
    <!--Outfit view-->
    <LinearLayout
        android:id="@+id/outfit_layout_generator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/randomize_button_generator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/jacket_image_generator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="0.25"
            android:scaleType="fitCenter"
            android:contentDescription="Randomly Selected Jacket"/>

        <ImageView
            android:id="@+id/shirt_image_generator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="0.25"
            android:scaleType="fitCenter"
            android:contentDescription="Randomly Selected Jacket"/>

        <ImageView
            android:id="@+id/pants_image_generator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="0.25"
            android:scaleType="fitCenter"
            android:contentDescription="Randomly Selected Jacket"/>

        <ImageView
            android:id="@+id/shoes_image_generator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="0.25"
            android:scaleType="fitCenter"
            android:contentDescription="Randomly Selected Jacket"/>

    </LinearLayout>
    <!--Lock item buttons-->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/randomize_button_generator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/lockJacket_button_generator"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:background="#0000000"
            android:contentDescription="Lock Jacket Button"
            android:src="@drawable/lock_24dp"
            app:tint="@color/grey"/>
        <ImageButton
            android:id="@+id/lockShirt_button_generator"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:background="#0000000"
            android:contentDescription="Lock Shirt Button"
            android:src="@drawable/lock_24dp"
            app:tint="@color/grey"/>
        <ImageButton
            android:id="@+id/lockPants_button_generator"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:background="#0000000"
            android:contentDescription="Lock Pants Button"
            android:src="@drawable/lock_24dp"
            app:tint="@color/grey"/>
        <ImageButton
            android:id="@+id/lockShoes_button_generator"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:background="#0000000"
            android:contentDescription="Lock Shoes Button"
            android:src="@drawable/lock_24dp"
            app:tint="@color/grey"/>
    </LinearLayout>
    <!--Randomize button-->
    <Button
        android:id="@+id/randomize_button_generator"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_24dp"
        android:contentDescription="Generate Outfit Button"
        app:layout_constraintTop_toBottomOf="@id/outfit_layout_generator"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_generator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!--Generate button-->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/generate_24dp"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/randomize_button_generator"
        app:layout_constraintBottom_toBottomOf="@id/randomize_button_generator"
        app:layout_constraintStart_toStartOf="@id/randomize_button_generator"
        app:layout_constraintEnd_toEndOf="@id/randomize_button_generator"/>
    <!--Save button-->
    <ImageButton
        android:id="@+id/saveOverlay_button_generator"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/button_background"
        android:contentDescription="Save Button"
        android:src="@drawable/save_24dp"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/randomize_button_generator"
        app:layout_constraintBottom_toBottomOf="@id/randomize_button_generator"
        app:layout_constraintStart_toEndOf="@id/randomize_button_generator"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!--Layout button-->
    <ImageButton
        android:id="@+id/layout_button_generator"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/button_background"
        android:contentDescription="Change Layout Button"
        android:src="@drawable/grid_view_24dp"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/randomize_button_generator"
        app:layout_constraintBottom_toBottomOf="@id/randomize_button_generator"
        app:layout_constraintEnd_toStartOf="@id/randomize_button_generator"
        app:layout_constraintStart_toStartOf="parent"/>
    <!--Save Overlay-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_overlay_generator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/outfit_layout_generator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outfit_name_generator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:hint="Outfit Name"
            app:layout_constraintTop_toTopOf="parent"
            app:counterMaxLength="15"
            style="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailSubject"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/outfit_name_generator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/cancel_button_generator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                android:layout_weight=".5"
                android:text="Cancel"/>
            <Button
                android:id="@+id/save_button_generator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                android:layout_weight=".5"
                android:text="Save"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_generator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        app:itemIconTint="@drawable/item_selector"
        app:itemRippleColor="@color/blue"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bottom_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_nav_generator" />

</androidx.constraintlayout.widget.ConstraintLayout>